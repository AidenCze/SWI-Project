@startuml
title Class diagram: Databázové modely rezervačního systému

skinparam class {
    BackgroundColor LightGray
    ArrowColor Black
    BorderColor Black
}

hide empty methods

class "User (Uživatel)" as User {
    + id : Integer
    + email : String [unique]
    + password : String
    + is_staff : Boolean
    + is_active : Boolean
    ---
    + set_password(raw_password: String) : void
    + check_password(raw_password: String) : Boolean
    + __str__() : String
}

class "ParkingLot (Parkoviště)" as Lot {
    + id : Integer
    + name : String [unique]
    + location : String
    + is_active : Boolean
    ---
    + get_total_capacity() : Integer
    + get_available_spots(date: Date) : Integer
    + __str__() : String
}

class "ParkingSpot (Parkovací místo)" as Spot {
    + id : Integer
    + number : String
    + is_active : Boolean
    + locked_until : DateTime [nullable]
    ---
    + is_locked() : Boolean
    + lock_spot(user: User) : void
    + unlock_spot() : void
    + __str__() : String
}

class "Reservation (Rezervace)" as Res {
    + id : Integer
    + date : Date
    + created_at : DateTime
    ---
    + clean() : void
    + save(*args, **kwargs) : void
    + is_cancelable() : Boolean
    + __str__() : String
}

' Relace (vztahy) s využitím správné UML notace
' Kompozice (plný kosočtverec) = CASCADE delete v Djangu
Lot "1" *-- "0..*" Spot : "obsahuje >"
User "1" *-- "0..*" Res : "vytváří >"
Spot "1" *-- "0..*" Res : "rezervováno pro >"

' Směrovaná asociace (otevřená šipka) = Dočasný volný vztah
User "0..1" --> "0..*" Spot : "dočasně zamyká >"

@enduml
