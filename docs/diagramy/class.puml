@startuml
title Class diagram: Databázové modely rezervačního systému

skinparam class {
    BackgroundColor LightGray
    ArrowColor Black
    BorderColor Black
}

' Skrytí prázdných částí pro větší přehlednost
hide empty methods

class "User (Uživatel)" as User {
    + id : Integer
    + email : String [unique]
    + password : String
    + is_staff : Boolean
    + is_active : Boolean
    ---
    + set_password(raw_password: String) : void
}

class "ParkingSpot (Parkovací místo)" as Spot {
    + id : Integer
    + number : String [unique]
    + is_active : Boolean
    + locked_until : DateTime [nullable]
    ---
    + is_locked() : Boolean
    + lock_spot(user: User) : void
    + unlock_spot() : void
}

class "Reservation (Rezervace)" as Res {
    + id : Integer
    + date : Date
    + created_at : DateTime
    ---
    + is_cancelable() : Boolean
}

' Relace (vztahy) mezi modely
User "1" -- "0..*" Res : "vytváří >"
Spot "1" -- "0..*" Res : "je rezervováno pro >"
User "0..1" -- "0..*" Spot : "dočasně zamyká >"

' Vysvětlující poznámky pro vyučujícího
note left of User
  Správce firmy se od běžného
  zaměstnance liší pouze
  příznakem is_staff = True.
  Email slouží jako přihlašovací jméno.
end note

note right of Spot
  Atributy locked_until a relace
  na uživatele řeší souběh transakcí
  (race condition) při výběru místa.
end note

note bottom of Res
  Metoda is_cancelable() ověřuje,
  zda termín rezervace ještě neproběhl,
  aby nešlo mazat historii.
end note

@enduml