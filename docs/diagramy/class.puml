@startuml
title Class Diagram

skinparam class {
    BackgroundColor LightGray
    ArrowColor Black
    BorderColor Black
}

hide empty methods

package "Boundary (UI Vrstva)" {
    class "AdminUI" as AdminUI <<Boundary>> {
        + submitNewEmployee(email: String)
        + clickDeleteEmployee(employeeId: Integer)
        + displayResult()
    }
    
    class "ReservationUI" as ResUI <<Boundary>> {
        + requestAvailableSpots(date: Date, time: Time)
        + selectSpot(spotId: Integer)
        + confirmReservation()
        + viewReservationDetails(reservationId: Integer)
        + cancelReservation(reservationId: Integer)
    }
}

package "Control (Řídící Vrstva)" {
    class "AdminController" as AdminCtrl <<Control>> {
        + processNewEmployee(email: String)
        + processDeleteEmployee(employeeId: Integer)
    }
    
    class "ReservationController" as ResCtrl <<Control>> {
        + getAvailableSpots(employee: User, date: Date, time: Time): List<ParkingSpot>
        + processReservation()
        + getReservationDetails(reservationId: Integer)
        + processCancellation(reservationId: Integer)
    }
}

package "Entity" {
    class "User" as User <<Entity>> {
        - id : Integer
        - email : String
        - passwordHash : String
        - isStaff : Boolean
        ---
        + {static} objects.get(id: Integer) : User
        + {static} objects.filter(email: String) : List<User>
        + save() : void
        + delete() : void
        + generatePassword() : void
        + getFutureReservations() : List<Reservation>
        + validateBusinessRules(date: Date, time: Time) : void
    }

    class "ParkingLot" as Lot <<Entity>> {
        - id : Integer
        - name : String
        ---
        + {static} objects.all() : List<ParkingLot>
        + getAvailableSpots(date: Date, time: Time) : List<ParkingSpot>
        + validateOperatingHours(time: Time) : void
    }

    class "ParkingSpot" as Spot <<Entity>> {
        - id : Integer
        - number : String
        ---
        + isAvailable(date: Date, time: Time) : Boolean
        + confirmReservation(date: Date, time: Time) : void
        + freeSpot(date: Date, time: Time) : void
    }

    class "Reservation" as Res <<Entity>> {
        - id : Integer
        - date : Date
        - time : Time
        - state : ReservationState
        ---
        + {static} objects.get(id: Integer) : Reservation
        + save() : void
        + getState() : ReservationState
        + cancel() : boolean
        + expire() : boolean
        - setState(state: ReservationState) : void
    }

    abstract class "ReservationState" as State <<State>> {
        # context : Reservation
        + cancel() : boolean
        + expire() : boolean
    }

    class "ActiveState" as StateActive <<ConcreteState>> {
        + cancel() : boolean
        + expire() : boolean
    }

    class "CancelledState" as StateCancelled <<ConcreteState>> {
        + cancel() : boolean
        + expire() : boolean
    }

    class "ExpiredState" as StateExpired <<ConcreteState>> {
        + cancel() : boolean
        + expire() : boolean
    }
}

class "SMTPServer" as SMTP <<External>> {
    + sendWelcomeEmail(email: String, password: String) : void
    + sendCancellationEmail(email: String, date: Date) : void
}

' Propojení UI a Control
AdminUI --> AdminCtrl
ResUI --> ResCtrl

' Propojení Control a Active Record Entit (Controller volá ORM)
AdminCtrl --> User
ResCtrl --> Lot
ResCtrl --> Spot
ResCtrl --> Res
ResCtrl --> User

' Propojení Control a External
AdminCtrl --> SMTP
ResCtrl --> SMTP

' Vztahy vzoru State
Res --> State
State <|-- StateActive
State <|-- StateCancelled
State <|-- StateExpired

' Datové a doménové vztahy (s UML notací kompozice)
Lot "1" *-- "0..*" Spot
User "1" *-- "0..*" Res
Spot "1" *-- "0..*" Res
User "0..1" --> "0..*" Spot
@enduml