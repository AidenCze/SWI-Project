@startuml
title Class Diagram

skinparam class {
    BackgroundColor LightGray
    ArrowColor Black
    BorderColor Black
}

hide empty methods

package "Boundary (UI Vrstva)" {
    class "AdminUI" as AdminUI <<Boundary>> {
        + submitNewEmployee(email: String)
        + clickDeleteEmployee(employeeId: Integer)
        + displayResult()
    }
    
    class "ReservationUI" as ResUI <<Boundary>> {
        + requestAvailableSpots(date: Date, time: Time)
        + selectSpot(spotId: Integer)
        + confirmReservation()
        + viewReservationDetails(reservationId: Integer)
        + cancelReservation(reservationId: Integer)
    }
}

package "Control (Řídící Vrstva)" {
    class "AdminController" as AdminCtrl <<Control>> {
        + processNewEmployee(email: String)
        + processDeleteEmployee(employeeId: Integer)
    }
    
    class "ReservationController" as ResCtrl <<Control>> {
        + getAvailableSpots(employee: User, date: Date, time: Time): List<ParkingSpot>
        + lockSpot(employee: User, spotId: Integer, date: Date, time: Time)
        + processReservation()
        + getReservationDetails(reservationId: Integer)
        + processCancellation(reservationId: Integer)
    }
}

package "Entity (Doménový Model)" {
    class "User" as User <<Entity>> {
        - id : Integer
        - email : String
        - passwordHash : String
        - isStaff : Boolean
        ---
        + {static} checkEmailExists(email: String) : Boolean
        + {static} authenticate(email, pass) : User
        + create(email: String) : User
        + generatePassword() : void
        + deleteAccount() : void
        + getFutureReservations() : List<Reservation>
        + validateBusinessRules(date: Date, time: Time) : void
    }

    class "ParkingLot" as Lot <<Entity>> {
        - id : Integer
        - name : String
        ---
        + getAvailableSpots(date: Date, time: Time) : List<ParkingSpot>
        + validateOperatingHours(time: Time) : void
    }

    class "ParkingSpot" as Spot <<Entity>> {
        - id : Integer
        - number : String
        ---
        + isAvailable(date: Date, time: Time) : Boolean
        + checkCurrentLocks(date: Date, time: Time) : Boolean
        + lockSpot(user: User, date: Date, time: Time, duration: int) : Boolean
        + unlockSpot(date: Date, time: Time) : void
        + confirmReservation(date: Date, time: Time) : void
        + freeSpot(date: Date, time: Time) : void
    }

    class "Reservation" as Res <<Entity>> {
        - id : Integer
        - date : Date
        - time : Time
        ---
        + create(employee: User, spot: ParkingSpot, date: Date, time: Time) : Reservation
        + getDetails() : Object
        + isCancelable() : Boolean
        + cancel() : void
    }
}

class "SMTPServer" as SMTP <<External>> {
    + sendWelcomeEmail(email: String, password: String) : void
    + sendCancellationEmail(email: String, date: Date) : void
}

' Propojení architektonických vrstev
AdminUI --> AdminCtrl
ResUI --> ResCtrl

AdminCtrl --> User
AdminCtrl --> SMTP

ResCtrl --> Lot
ResCtrl --> Spot
ResCtrl --> Res
ResCtrl --> User
ResCtrl --> SMTP

' Datové a doménové vztahy (s UML notací kompozice)
Lot "1" *-- "0..*" Spot
User "1" *-- "0..*" Res
Spot "1" *-- "0..*" Res
User "0..1" --> "0..*" Spot
@enduml