@startuml
title Class diagram

skinparam class {
    BackgroundColor LightGray
    ArrowColor Black
    BorderColor Black
}

class "User" as User {
    + id : Integer
    + email : String [unique]
    + password : String
    + is_staff : Boolean
    + is_active : Boolean
    ---
    + set_password(raw_password: String) : void
    + check_password(raw_password: String) : Boolean
    + __str__() : String
}

class "ParkingSpot" as Spot {
    + id : Integer
    + number : String [unique]
    + is_active : Boolean
    + locked_until : DateTime [nullable]
    ---
    + is_locked() : Boolean
    + lock_spot(user: User) : void
    + unlock_spot() : void
    + __str__() : String
}

class "Reservation" as Res {
    + id : Integer
    + date : Date
    + created_at : DateTime
    ---
    + clean() : void
    + save(*args, **kwargs) : void
    + is_cancelable() : Boolean
    + __str__() : String
}

' Relace (vztahy) mezi modely
User "1" -- "0..*" Res : "vytváří >"
Spot "1" -- "0..*" Res : "je rezervováno pro >"
User "0..1" -- "0..*" Spot : "dočasně zamyká >"

@enduml
