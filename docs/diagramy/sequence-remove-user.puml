@startuml
title Sequence Diagram: Delete Employee

actor "admin : User" as admin
participant "ui : AdminUI" as ui
participant "ctrl : AdminController" as ctrl
participant "emp : User" as emp
participant "res : Reservation" as res


== 1. Požadavek na smazání ==
admin -> ui : clickDeleteEmployee(employeeId)
activate ui

ui -> ctrl : processDeleteEmployee(employeeId)
activate ctrl

== 2. Zrušení rezervací (Kaskádové mazání) ==
ctrl -> emp : deleteAccount()
activate emp


emp -> emp : getReservations()

loop for each reservation
    emp -> res : cancel()
    activate res
    

    res --> emp : void
    destroy res

end

== 3. Odstranění uživatele ==
emp --> ctrl : void
destroy emp


ctrl --> ui : successMessage
deactivate ctrl

ui --> admin : displayResult()
deactivate ui
@enduml