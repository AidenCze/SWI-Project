@startuml
title Implementation of the State design pattern

skinparam class {
    BackgroundColor LightGray
    ArrowColor Black
    BorderColor Black
}

class "Reservation" as Res <<Context>>  {
    - id : Integer
    - state : ReservationState
    + getState() : ReservationState
    + confirm() : boolean
    + cancel() : boolean
    + expire() : boolean
    - setState(state: ReservationState) : void
}



abstract class "ReservationState" as State <<State>> {
    # context : Reservation
    + confirm() : boolean
    + cancel() : boolean
    + expire() : boolean
}

class "PendingState" as StatePending <<ConcreteState>> {
    + confirm() : boolean
    + cancel() : boolean
    + expire() : boolean
}

class "ActiveState" as StateActive <<ConcreteState>> {
    + confirm() : boolean
    + cancel() : boolean
    + expire() : boolean
}

class "CancelledState" as StateCancelled <<ConcreteState>> {
    + confirm() : boolean
    + cancel() : boolean
    + expire() : boolean
}

class "ExpiredState" as StateExpired <<ConcreteState>> {
    + confirm() : boolean
    + cancel() : boolean
    + expire() : boolean
}


' Strukturální vztahy vzoru State
Res *--> "1" State : state
State <|-- StatePending
State <|-- StateActive
State <|-- StateCancelled
State <|-- StateExpired
@enduml