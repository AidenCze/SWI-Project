@startuml
title Implementace návrhového vzoru State

skinparam class {
    BackgroundColor LightGray
    ArrowColor Black
    BorderColor Black
}

class "Reservation" as Res <<Context>>  {
    - id : Integer
    - state : ReservationState
    + getState() : ReservationState
    + cancel() : boolean
    + expire() : boolean
    - setState(state: ReservationState) : void
}



abstract class "ReservationState" as State <<State>> {
    # context : Reservation
    + cancel() : boolean
    + expire() : boolean
}

class "ActiveState" as StateActive <<ConcreteState>> {
    + cancel() : boolean
    + expire() : boolean
}

class "CancelledState" as StateCancelled <<ConcreteState>> {
    + cancel() : boolean
    + expire() : boolean
}

class "ExpiredState" as StateExpired <<ConcreteState>> {
    + cancel() : boolean
    + expire() : boolean
}





' Strukturální vztahy vzoru State
Res *--> State : state
State <|-- StateActive
State <|-- StateCancelled
State <|-- StateExpired
@enduml