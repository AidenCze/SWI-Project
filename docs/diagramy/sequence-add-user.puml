@startuml
title Sequence Diagram: Add Employee

actor "admin : User" as admin
participant "ui : AdminUI" as ui
participant "ctrl : AdminController" as ctrl
participant "User <<Class>>" as userClass
participant "newEmp : User" as newEmp
participant "smtp : SMTPServer" as smtp <<External>>

== 1. Požadavek na vytvoření ==
admin -> ui : submitNewEmployee(email)
activate ui

ui -> ctrl : processNewEmployee(email)
activate ctrl

== 2. Validace e-mailu ==
' Změněno na volání Active Record metody definované v Class diagramu
ctrl -> userClass : objects.filter(email)
activate userClass

' Controller vyhodnotí, zda seznam obsahuje uživatele
userClass --> ctrl : List<User>
deactivate userClass

alt List<User> is empty (e-mail je unikátní)
    == 3. Vytvoření a inicializace uživatele ==
    ctrl -> newEmp ** : create(email)
    activate newEmp
    
    newEmp -> newEmp : generatePassword()
    
    ' PŘIDÁNO: Volání metody save() pro Active Record
    newEmp -> newEmp : save()
    
    newEmp --> ctrl : User (new instance)
    deactivate newEmp
    
    == 4. Odeslání notifikace ==
    ' Controller má přístup k vygenerovanému heslu např. přes get vlastnost nebo před uložením hashe
    ctrl -> smtp : sendWelcomeEmail(email, generatedPassword)
    activate smtp

    smtp --> ctrl : void (success)
    deactivate smtp
    
    ctrl --> ui : successMessage
else List<User> is NOT empty (e-mail již existuje)
    ctrl --> ui : errorMessage
end
deactivate ctrl

ui --> admin : displayResult()
deactivate ui
@enduml