@startuml
title Sequence Diagram: Add Employee (BCE with External Service)

actor "admin : User" as admin
participant "ui : AdminUI" as ui
participant "ctrl : AdminController" as ctrl
participant "User <<Class>>" as userClass
participant "newEmp : User" as newEmp
participant "smtp : SMTPServer" as smtp <<External>>

== 1. Požadavek na vytvoření ==
admin -> ui : submitNewEmployee(email)
activate ui

ui -> ctrl : processNewEmployee(email)
activate ctrl

== 2. Validace e-mailu ==
ctrl -> userClass : checkEmailExists(email)
activate userClass

userClass --> ctrl : Boolean (exists)
deactivate userClass

alt exists == false (e-mail je unikátní)
    == 3. Vytvoření a inicializace uživatele ==
    ctrl -> newEmp ** : create(email)
    activate newEmp
    
    newEmp -> newEmp : generatePassword()

    
    newEmp --> ctrl : User (new instance)
    deactivate newEmp
    
    == 4. Odeslání notifikace ==
    ctrl -> smtp : sendWelcomeEmail(email, generatedPassword)
    activate smtp

    smtp --> ctrl : void (success)
    deactivate smtp
    
    ctrl --> ui : successMessage
else exists == true (e-mail již existuje)
    ctrl --> ui : errorMessage
end
deactivate ctrl

ui --> admin : displayResult()
deactivate ui
@enduml