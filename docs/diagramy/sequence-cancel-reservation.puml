@startuml
title Sequence Diagram: Cancel Reservation (BCE, State & Active Record)

actor "employee : User" as emp
participant "ui : ReservationUI" as ui
participant "ctrl : ReservationController" as ctrl
participant "Reservation <<Class>>" as resClass
participant "res : Reservation" as res
participant "state : ReservationState" as state
participant "smtp : SMTPServer" as smtp <<External>>

== 1. Zobrazení detailu rezervace ==
emp -> ui : viewReservationDetails(reservationId)
activate ui

ui -> ctrl : getReservationDetails(reservationId)
activate ctrl

' Active Record: Načtení z databáze
ctrl -> resClass : objects.get(reservationId)
activate resClass
resClass --> ctrl : res
deactivate resClass

ctrl --> ui : summaryData
deactivate ctrl

ui --> emp : displayReservation()
deactivate ui

== 2. Proces zrušení ==
emp -> ui : cancelReservation(reservationId)
activate ui

ui -> ctrl : processCancellation(reservationId)
activate ctrl

' Znovunačtení entity (nebo použití z paměti)
ctrl -> resClass : objects.get(reservationId)
activate resClass
resClass --> ctrl : res
deactivate resClass

' Využití návrhového vzoru State
ctrl -> res : cancel()
activate res

res -> state : cancel()
activate state

state --> res : Boolean (success)
deactivate state

res --> ctrl : Boolean (success)
deactivate res

alt success == true (zrušení povoleno)
    ' Uložení změn do databáze (Soft Delete)
    ctrl -> res : save()
    activate res
    res --> ctrl : void
    deactivate res
    
    ' Volitelné: Odeslání e-mailu definované v Class diagramu
    ctrl -> smtp : sendCancellationEmail(email, date)
    activate smtp
    smtp --> ctrl : void
    deactivate smtp
    
    ctrl --> ui : successMessage
else success == false (již zrušeno nebo v minulosti)
    ctrl --> ui : errorMessage
end
deactivate ctrl

ui --> emp : displayResult()
deactivate ui
@enduml