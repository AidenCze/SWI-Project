@startuml
title Sequence Diagram: Cancel Reservation

actor "employee : User" as emp
participant "ui : ReservationUI" as ui
participant "ctrl : ReservationController" as ctrl
participant "res : Reservation" as res
participant "spot : ParkingSpot" as spot

== 1. Zobrazení detailu rezervace ==
emp -> ui : viewReservationDetails(reservationId)
activate ui

ui -> ctrl : getReservationDetails(reservationId)
activate ctrl

ctrl -> res : getDetails()
activate res
res --> ctrl : details
deactivate res

ctrl --> ui : summaryData
deactivate ctrl

ui --> emp : displayReservation()
deactivate ui

== 2. Proces zrušení ==
emp -> ui : cancelReservation(reservationId)
activate ui

ui -> ctrl : processCancellation(reservationId)
activate ctrl

ctrl -> res : isCancelable()
activate res
note right of res: Entita zkontroluje svá data,\nzda termín již neproběhl.
res --> ctrl : Boolean
deactivate res

alt isCancelable() == true
    ctrl -> res : cancel()
    activate res
    
    res -> spot : freeSpot(date, time)
    activate spot
    spot --> res : void
    deactivate spot
    
    res --> ctrl : void
    destroy res
    note right of ctrl: Entita Reservation je zničena.
    
    ctrl --> ui : successMessage
else reservation is in the past (not cancelable)
    ctrl --> ui : errorMessage
end
deactivate ctrl

ui --> emp : displayResult()
deactivate ui
@enduml