@startuml
title Sequence Diagram: Reservation Process (BCE, State & Active Record)

actor "employee : User" as emp
participant "ui : ReservationUI" as ui
participant "ctrl : ReservationController" as ctrl
participant "ParkingLot <<Class>>" as lotClass
participant "lot : ParkingLot" as lot
participant "spot : ParkingSpot" as spot
participant "res : Reservation" as res

== 1. Hledání dostupného místa ==
emp -> ui : requestAvailableSpots(date, time)
activate ui

ui -> ctrl : getAvailableSpots(employee, date, time)
activate ctrl



' Načtení parkoviště (Active Record)
ctrl -> lotClass : objects.all()
activate lotClass
lotClass --> ctrl : List<ParkingLot>
deactivate lotClass

ctrl -> lot : getAvailableSpots(date, time)
activate lot

loop for each spot in lot
    ' Volání metody, kterou máš v Class diagramu
    lot -> spot : isAvailable(date, time)
    activate spot
    spot --> lot : Boolean
    deactivate spot
end

lot --> ctrl : List<ParkingSpot>
deactivate lot

ctrl --> ui : spotList
deactivate ctrl

ui --> emp : displayAvailableSpots()
deactivate ui

== 2. Dočasný zámek (Vytvoření Draftu / PendingState) ==
emp -> ui : selectSpot(spotId)
activate ui

' UI informuje Controller o výběru
ui -> ctrl : processSelection(spotId)
activate ctrl

' VYTVOŘENÍ ZÁMKU: Instancování rezervace ve stavu Pending
ctrl -> res ** : create(date, time, new PendingState())
activate res
res --> ctrl : res (Draft)
deactivate res

' Zápis zámku do databáze
ctrl -> res : save()
activate res
res --> ctrl : void
deactivate res

ctrl --> ui : summaryData
deactivate ctrl

ui --> emp : displaySummary()
deactivate ui

== 3. Potvrzení rezervace (Přechod stavu) ==
emp -> ui : confirmReservation()
activate ui

ui -> ctrl : processReservation()
activate ctrl

' Využití vzoru State k potvrzení
ctrl -> res : confirm()
activate res



res --> ctrl : Boolean (true)
deactivate res

' Entita místa se dozví o potvrzení (dle tvého Class diagramu)
ctrl -> spot : confirmReservation(date, time)
activate spot
spot --> ctrl : void
deactivate spot

' Uložení nového stavu do databáze
ctrl -> res : save()
activate res
res --> ctrl : void
deactivate res

ctrl --> ui : successMessage
deactivate ctrl

ui --> emp : displayConfirmation()
deactivate ui
@enduml