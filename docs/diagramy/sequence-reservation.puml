@startuml
title Sequence Diagram: Reservation Process

actor "employee : User" as emp
participant "ui : ReservationUI" as ui
participant "ctrl : ReservationController" as ctrl
participant "lot : ParkingLot" as lot
participant "spot : ParkingSpot" as spot
participant "res : Reservation" as res

== 1. Hledání dostupného místa ==
emp -> ui : requestAvailableSpots(date, time)
activate ui

ui -> ctrl : getAvailableSpots(employee, date, time)
activate ctrl

ctrl -> ctrl : validateBusinessRules(employee, date, time)


ctrl -> lot : getAvailableSpots(date, time)
activate lot

loop for each spot in lot.spots
    lot -> spot : isAvailable(date, time)
    activate spot
    spot -> spot : checkCurrentLocks(date, time)
    spot --> lot : Boolean
    deactivate spot
end

lot --> ctrl : List<ParkingSpot>
deactivate lot

ctrl --> ui : spotList
deactivate ctrl

ui --> emp : displayAvailableSpots()
deactivate ui

== 2. Dočasný zámek a sumarizace ==
emp -> ui : selectSpot(spotId)
activate ui

ui -> ctrl : lockSpot(employee, spotId, date, time)
activate ctrl

ctrl -> spot : lockSpot(employee, date, time)
activate spot
spot --> ctrl : Boolean (isLocked)
deactivate spot

ctrl --> ui : summaryData
deactivate ctrl

ui --> emp : displaySummary()
deactivate ui

== 3. Potvrzení a vytvoření rezervace ==
emp -> ui : confirmReservation()
activate ui

ui -> ctrl : processReservation()
activate ctrl

ctrl -> res ** : create(employee, spot, date, time)
activate res

res -> spot : confirmReservation(date, time)
activate spot
spot --> res : void
deactivate spot

res --> ctrl : Reservation
deactivate res

ctrl -> spot : unlockSpot(date, time)
activate spot
spot --> ctrl : void
deactivate spot

ctrl --> ui : successMessage
deactivate ctrl

ui --> emp : displayConfirmation()
deactivate ui
@enduml